<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1117"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- PERMISSION STATUS CARDS -->
        <LinearLayout
            android:id="@+id/cardOverlayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_dark_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Overlay Permission"
                android:textColor="#F0F6FC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOverlayBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill_active"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="ACTIVE"
                android:textColor="#22C55E"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardAccessibilityStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_dark_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Accessibility Service"
                android:textColor="#F0F6FC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAccessibilityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill_active"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="RUNNING"
                android:textColor="#22C55E"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardBatteryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_dark_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Keep Alive (Battery)"
                android:textColor="#F0F6FC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBatteryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill_active"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="UNRESTRICTED"
                android:textColor="#22C55E"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CONTROLS SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:letterSpacing="0.08"
            android:text="CONTROLS"
            android:textColor="#8B949E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/btnStartMultiTarget"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_primary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="START MULTI-TARGET MODE"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnMultiTargetSettings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_dark_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Multi-Target Settings"
                android:textColor="#F0F6FC"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnAutoOpenSettings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_dark_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto-Open Settings"
                android:textColor="#F0F6FC"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnInstructions"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/bg_dark_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instructions"
                android:textColor="#F0F6FC"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PERMISSION DETAILS HEADER (TAP TO EXPAND/COLLAPSE ALL) -->
        <LinearLayout
            android:id="@+id/headerPermissionDetailsAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="PERMISSION DETAILS"
                android:textColor="#8B949E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvToggleAllHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expand All"
                android:textColor="#38BDF8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- EXPANDABLE / COLLAPSIBLE PERMISSION DETAILS CARD -->
        <LinearLayout
            android:id="@+id/cardPermissionDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dark_card"
            android:orientation="vertical">

            <!-- Item 1: Overlay Permission -->
            <LinearLayout
                android:id="@+id/rowOverlayDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Overlay Permission"
                        android:textColor="#F0F6FC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivChevronOverlay"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Expand Overlay Permission"
                        android:src="@drawable/ic_chevron_down" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDescOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Allows QuickClick to display the floating control bar and touch target indicators over other apps so you can position and control auto-clicks anywhere on screen."
                    android:textColor="#9CA3AF"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#232834" />

            <!-- Item 2: Accessibility Service -->
            <LinearLayout
                android:id="@+id/rowAccessibilityDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Accessibility Service"
                        android:textColor="#F0F6FC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivChevronAccessibility"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Expand Accessibility Service"
                        android:src="@drawable/ic_chevron_down" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDescAccessibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Starting the QuickClick accessibility service allows this application to send clicks/taps and swipes on your behalf. You can disable it at any time, but it will need to be enabled for QuickClick to run."
                    android:textColor="#9CA3AF"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#232834" />

            <!-- Item 3: Keep Alive (Battery) -->
            <LinearLayout
                android:id="@+id/rowBatteryDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Keep Alive (Battery)"
                        android:textColor="#F0F6FC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivChevronBattery"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Expand Keep Alive Battery"
                        android:src="@drawable/ic_chevron_down" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDescBattery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Disabling battery optimization prevents Android from putting QuickClick to sleep or stopping background execution during long scheduled timers and continuous click cycles."
                    android:textColor="#9CA3AF"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- VERSION FOOTER -->
        <TextView
            android:id="@+id/tvVersionFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:text="Version 1.0.0"
            android:textColor="#6E7681"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
